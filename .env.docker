# ================================================
# Docker 环境变量配置
# ================================================

# 数据库配置
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=nlqdb
DB_PORT=13306
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0

# 应用端口配置（默认避开 80/3306 等常用端口，减少现场冲突）
FRONTEND_PORT=18080
BACKEND_PORT=18011

# 应用配置
DEBUG=False
DISABLE_FASTAPI_THREADPOOL=true

# 安全配置（生产环境请修改）
SECRET_KEY=your-secret-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-32bytes-long!

# LLM 配置（可选）
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4-turbo
# DEFAULT_LLM_API_KEY=sk-xxx
# DEFAULT_LLM_API_BASE=https://api.openai.com/v1
